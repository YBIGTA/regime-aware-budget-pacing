      "ridge_alpha": 100.0,
      "target": "log(max(offline finite difference at B base +/-0.05,1e-5))",
      "label_scope": "FIT240 current auction tape only for offline supervision; no current tape features",
      "scaling": "fit240 mean/std only; standardized features clipped +/-8 at prediction",
      "prediction_clip": [
